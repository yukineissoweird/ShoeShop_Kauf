<Window x:Class="labaBashun.ManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:labaBashun"
        mc:Ignorable="d"
        Title="ManagerWindow" Height="450" Width="800">
    <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Background="#7FFF00" Margin="0,0,0,10" Height="70">
                <TextBlock Text="ООО Обувь" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" FontFamily="Times New Roman" Margin="0,20,0,0"/>
                <Image Source="/Matetials/Icon.png" Width="50" Height="40" Margin="-155,-30,0,0"/>
                <Button Width="105" Height="20" Content="Выйти из системы" Margin="-675,-40,0,0" FontFamily="Times New Roman" Click="Button_Click"/>
                <Label Content="Менеджер" Width="115" Height="25" Margin="675,-40,0,0" FontFamily="Times New Roman" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Grid.Row="1" Background="#7FFF00" Margin="0,0,0,10" >
                <Label Content="Поиск:" Margin="-760,15,0,0" FontFamily="Times New Roman" Width="45"/>
                <TextBox Width="100" Height="15" Margin="-600,-20,0,0" TextChanged="TextBox_TextChanged" Name="TxtSearch"/>
                <Label Content="Сортировка(По количеству на складе)" HorizontalAlignment="Center" Margin="-200,-60,0,0" FontFamily="Times New Roman" Height="24"/>
                <Button Width="100" Height="17" Content="По возрастанию" Margin="-275,-15,0,0" FontFamily="Times New Roman" Click="Button_Click_1"/>
                <Button Width="100" Height="17" Content="По убыванию" Margin="-45,-17,0,0" FontFamily="Times New Roman" Click="Button_Click_2"/>
                <Label Content="Поставщик:" FontFamily="Times New Roman" Margin="450,-20,0,0"/>
                <ComboBox Width="125" Height="20" Margin="360,-20,0,0" Name="Cmb_Supplier" SelectionChanged="Cmb_Supplier_SelectionChanged" DisplayMemberPath="Supplier_Name" SelectedValuePath="ID_provider"/>
                <Button Content="Сбросить фильтры" Width="126" Margin="650,-20,0,0" FontFamily="Times New Roman" Height="17" Click="Button_Click_3"/>
            </StackPanel>

            <ListView Name="ListProduct" Margin="0,60,0,0" Grid.Row="2" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding is_discount}" Value="True">
                                <Setter Property="Background" Value="#2E8B57"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding is_quantity}" Value="True">
                                <Setter Property="Background" Value="Cyan"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border BorderThickness="2" Margin="5" BorderBrush="Black">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="520"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top" Width="500">
                                    <TextBlock Text="ООО Обувь"/>
                                </StackPanel>
                                <Border Grid.Column="0" BorderThickness="2" Margin="5" BorderBrush="Black">
                                    <Image Source="{Binding Photo}" Margin="10" Width="120"/>
                                </Border>

                                <Border Grid.Column="1" BorderThickness="1" Margin="5" BorderBrush="Black">
                                    <StackPanel Margin="5" Orientation="Vertical">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Category1.Category_Name}" FontWeight="Bold"/>
                                            <TextBlock Text=" | " FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Product_Name1.Product_Name1}" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Описание товара: "/>
                                            <TextBlock Text="{Binding Description}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Производитель: "/>
                                            <TextBlock Text="{Binding Manufacturer1.Manufacturer_Name}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Поставщик: "/>
                                            <TextBlock Text="{Binding Supplier1.Supplier_Name}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Цена: "/>
                                            <TextBlock Text="{Binding Price}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding is_on_sale}" Value="True">
                                                                <Setter Property="Foreground" Value="Red"/>
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Margin="5,0,0,0" Text="{Binding price_discount, StringFormat=Новая цена: {0} руб.}" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Единица измерения: "/>
                                            <TextBlock Text="{Binding Measure1.Measure_Name}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Количество на складе: "/>
                                            <TextBlock Text="{Binding Quantity}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" BorderThickness="1" Margin="5" BorderBrush="Black">
                                    <TextBlock Text="{Binding Discount}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
</Window>
