
<Window x:Class="labaBashun.OrderListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Список заказов"
        Height="520" Width="1000"
        MinHeight="400" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="#FFFFFF"
        FontFamily="Times New Roman"
        FontSize="15">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#00FA9A"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#333333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#7FFF00"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="6"/>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="#7FFF00"
                Padding="10"
                Margin="0,0,0,12">
            <TextBlock Text="Список заказов"
                       FontSize="23"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>
        </Border>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <TextBlock x:Name="RoleText"
                       VerticalAlignment="Center"
                       Foreground="#333333"
                       FontSize="14"/>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right">

                <Button x:Name="AddButton"
                        Content="Добавить заказ"
                        Width="130"
                        Height="32"
                        Margin="0,0,8,0"
                        Click="AddButton_Click"/>

                <Button x:Name="DeleteButton"
                        Content="Удалить выбранный"
                        Width="155"
                        Height="32"
                        Click="DeleteButton_Click"/>
            </StackPanel>
        </DockPanel>

        <DataGrid x:Name="OrdersGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Extended"
                  SelectionUnit="FullRow"
                  MouseDoubleClick="OrdersGrid_MouseDoubleClick"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeight="34"
                  FontFamily="Times New Roman"
                  FontSize="14"
                  Background="#FFFFFF"
                  AlternatingRowBackground="#F2FFF2"
                  BorderBrush="#7FFF00"
                  BorderThickness="1">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Артикул"
                                    Binding="{Binding Article}"
                                    Width="110"/>

                <DataGridTextColumn Header="Статус заказа"
                                    Binding="{Binding Status}"
                                    Width="150"/>

                <DataGridTextColumn Header="Адрес пункта выдачи"
                                    Binding="{Binding PickupAddress}"
                                    Width="*"
                                    MinWidth="230"/>

                <DataGridTextColumn Header="Дата заказа"
                                    Binding="{Binding OrderDate, StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="120"/>

                <DataGridTextColumn Header="Дата выдачи"
                                    Binding="{Binding DeliveryDate, StringFormat={}{0:dd.MM.yyyy}}"
                                    Width="120"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>
