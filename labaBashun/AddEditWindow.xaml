<Window x:Class="labaBashun.AddEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:labaBashun"
        mc:Ignorable="d"
        Title="Управление товаром"
        Height="720"
        Width="850"
        MinHeight="650"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        Background="#FFFFFF"
        FontFamily="Times New Roman">

    <Window.Resources>
        <Style TargetType="Label">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Padding" Value="5,3"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Background" Value="#00FA9A"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Border Grid.Row="0" Background="#7FFF00">
            <TextBlock Text="Управление товаром"
                       FontSize="27"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">

            <Grid Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Изображение -->
                <Label Grid.Row="0" Grid.Column="0"
                       Content="Фото товара"/>

                <StackPanel Grid.Row="0" Grid.Column="1"
                            Orientation="Horizontal"
                            Margin="0,5,0,12">

                    <Border BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            Width="100"
                            Height="85"
                            Background="#FFFFFF"
                            Margin="0,0,15,0">
                        <Image x:Name="PhotoProduct"
                               Source="{Binding Photo}"
                               Stretch="Uniform"/>
                    </Border>

                    <StackPanel VerticalAlignment="Center">
                        <Button Content="Выбрать изображение"
                                Width="175"
                                Height="32"
                                HorizontalAlignment="Left"
                                Click="Button_Click_1"/>

                        <TextBox x:Name="TxtPhotoName"
                                 Width="250"
                                 IsReadOnly="True"
                                 Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Артикул -->
                <Label Grid.Row="1" Grid.Column="0"
                       Content="Артикул товара"/>
                <TextBox x:Name="TxtArticle"
                         Grid.Row="1" Grid.Column="1"/>

                <!-- Наименование -->
                <Label Grid.Row="2" Grid.Column="0"
                       Content="Наименование товара"/>
                <TextBox x:Name="TxtName"
                         Grid.Row="2" Grid.Column="1"/>

                <!-- Категория -->
                <Label Grid.Row="3" Grid.Column="0"
                       Content="Категория товара"/>
                <ComboBox x:Name="CmbCategory"
                          Grid.Row="3" Grid.Column="1"
                          SelectedItem="{Binding Category1}"
                          SelectedValuePath="ID_category"
                          DisplayMemberPath="Category_Name"/>

                <!-- Описание -->
                <Label Grid.Row="4" Grid.Column="0"
                       Content="Описание товара"/>
                <TextBox x:Name="TxtDescription"
                         Grid.Row="4" Grid.Column="1"
                         Height="55"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"/>

                <!-- Производитель -->
                <Label Grid.Row="5" Grid.Column="0"
                       Content="Производитель товара"/>
                <ComboBox x:Name="CmbManufacturer"
                          Grid.Row="5" Grid.Column="1"
                          SelectedValue="{Binding Product.Manufacturer1}"
                          SelectedValuePath="ID_Manufacturer"
                          DisplayMemberPath="Manufacturer_Name"/>

                <!-- Поставщик -->
                <Label Grid.Row="6" Grid.Column="0"
                       Content="Поставщик товара"/>
                <ComboBox x:Name="CmbSupplier"
                          Grid.Row="6" Grid.Column="1"
                          SelectedValue="{Binding Product.Supplier1}"
                          SelectedValuePath="ID_provider"
                          DisplayMemberPath="Supplier_Name"/>

                <!-- Цена -->
                <Label Grid.Row="7" Grid.Column="0"
                       Content="Цена товара"/>
                <TextBox x:Name="TxtPrice"
                         Grid.Row="7" Grid.Column="1"/>

                <!-- Единица измерения -->
                <Label Grid.Row="8" Grid.Column="0"
                       Content="Единица измерения"/>
                <ComboBox x:Name="CmbMeasure"
                          Grid.Row="8" Grid.Column="1"
                          SelectedValue="{Binding Product.Measure1}"
                          SelectedValuePath="ID_measure"
                          DisplayMemberPath="Measure_Name"/>

                <!-- Количество -->
                <Label Grid.Row="9" Grid.Column="0"
                       Content="Количество на складе"/>
                <TextBox x:Name="TxtQuantity"
                         Grid.Row="9" Grid.Column="1"/>

                <!-- Скидка -->
                <Label Grid.Row="10" Grid.Column="0"
                       Content="Действующая скидка"/>
                <TextBox x:Name="TxtDiscount"
                         Grid.Row="10" Grid.Column="1"/>
            </Grid>
        </ScrollViewer>

        <!-- Кнопка сохранения -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                BorderBrush="#DDDDDD"
                BorderThickness="0,1,0,0">

            <Button Content="Сохранить данные"
                    Width="180"
                    Height="38"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Click="Button_Click"/>
        </Border>
    </Grid>
</Window>
