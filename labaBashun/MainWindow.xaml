<Window x:Class="labaBashun.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:labaBashun"
        mc:Ignorable="d"
        Title="ООО Обувь - Авторизация" Height="450" Width="800">
    <Grid>
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Orientation="Horizontal" Width="790" Margin="10,10,0,0" Height="88" Background="#7FFF00">
            <Image Source="/Matetials/Icon.png" Height="82" Width="59" Margin="150,0,0,0"/>
            <Label Content="Авторизация" Background="#7FFF00" FontSize="40" VerticalAlignment="Center" Margin="70,0,0,0" FontFamily="Times New Roman" Width="230" HorizontalAlignment="Center"/>
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Orientation="Vertical" HorizontalAlignment="Center" Width="200">
            <TextBlock Text="Логин" Margin="5" FontSize="16" />
            <TextBox Margin="5" Name="Login"/>
            <TextBlock Text="Пароль" Margin="5" FontSize="16"/>
            <PasswordBox Margin="5" Name="Password"/>
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Width="110">
                <Button Width="95" Height="50" Margin="5" Content="Войти"  Background="Green" Click="Button_Click"/>

            </StackPanel>
            <StackPanel>
                <Button Width="95" Height="50" Margin="5" Content="Войти как гость" Click="Button_Click_1"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
